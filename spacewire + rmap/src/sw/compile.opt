# --- INCLUDE ---

-I src/sw/include

# --- OPTIMIZATION ---

                    # -Z0 - optimization level 0
                    # -Z1 - optimization level 1
                    # -Z2 - optimization level 2
                    # -Z2 -Ts  - optimization level 2 + speed optimization
                    # -Z2 -Tz  - optimization level 2 + size  optimization

# --- SPECIAL MODES ---

                    # -X1 - insert NOP between POPA and POP instructions
                    # -X2 - alignment labels and function entry points
                    # -X3 - on SHR instruction check shift register on zero value
                    # -X4 - on SUBC instruction correct the carry flag 
                    # -X5 - do not use TIJMP on table branch for switch operator
                    # -X6 - do not use long address with SP register

# --- OBJECT FILE ---

-G bin/cmc96/main.mco
